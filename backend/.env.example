# Public identity-provider configuration. Authentication stays disabled until all are set.
# Use a provider-issued JWT ACCESS token conforming to the documented restricted profile.
# Do not put private signing keys or access tokens in this file.
COSIGNA_IDENTITY_ISSUER=https://identity.example.test/
COSIGNA_IDENTITY_AUDIENCE=urn:cosigna:application-api
COSIGNA_IDENTITY_CLIENT_IDS=["cosigna-web"]
# Native Ruby: an absolute path to a public RSA JWKS outside the repository.
COSIGNA_IDENTITY_JWKS_PATH=/run/cosigna/identity-jwks.json
# Docker override: absolute HOST path of that public file (the container path is fixed).
COSIGNA_IDENTITY_JWKS_HOST_PATH=
