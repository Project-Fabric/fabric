# TLS in front of the gateway. Caddy keeps the Host header and sets X-Forwarded-Proto, which
# the gateway requires. For a public DNS name Caddy obtains a certificate automatically
# (ports 80 and 443 must be reachable); `localhost` uses Caddy's own local CA. For an internal
# name, add `tls internal` or `tls /certs/cert.pem /certs/key.pem` inside the block.
{$COSIGNA_PUBLIC_HOST} {
	reverse_proxy gateway:3092
}
